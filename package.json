{
  "name": "config-editor-base",
  "version": "4.0.4",
  "description": "React-based JSON Schema editor base-tool",
  "author": "CSS Electronics",
  "license": "MIT",
  "repository": "CSS-Electronics/config-editor-base",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "microbundle --no-compress --format esm,cjs --jsx React.createElement --jsxFragment React.Fragment",
    "start": "microbundle watch --no-compress --format esm,cjs --jsx React.createElement --jsxFragment React.Fragment",
    "prepare": "run-s build",
    "test": "run-s test:unit test:build",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "predeploy": "cd example && npm install && npm run build",
    "deploy": "gh-pages -d example/dist"
  },
  "peerDependencies": {
    "classnames": "^2.2.6",
    "crc": "^3.8.0",
    "file-saver": "^2.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-files": "^2.4.8",
    "react-redux": "^8.0.0",
    "react-select": "^5.0.0"
  },
  "devDependencies": {
    "babel-eslint": "^10.0.3",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.7.0",
    "eslint-config-standard": "^14.1.0",
    "eslint-config-standard-react": "^9.2.0",
    "eslint-plugin-import": "^2.18.2",
    "eslint-plugin-node": "^11.0.0",
    "eslint-plugin-prettier": "^3.1.1",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-react": "^7.17.0",
    "eslint-plugin-standard": "^4.0.1",
    "gh-pages": "^2.2.0",
    "microbundle": "^0.15.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "overrides": {
    "diff2html": "3.1.6",
    "react-gh-like-diff": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-files": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "dependencies": {
    "@rjsf/core": "^6.7.1",
    "@rjsf/utils": "^6.7.1",
    "@rjsf/validator-ajv8": "^6.7.1",
    "ajv": "^8.17.1",
    "deepmerge": "^4.1.1",
    "diff2html": "3.1.6",
    "lodash": "^4.17.21",
    "react-gh-like-diff": "^2.0.2",
    "rjsf-tabs": "^0.0.2"
  }
}
